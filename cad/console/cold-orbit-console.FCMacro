    # --- 7.8 engineering -----------------------------------------------
    "eng_title":            "ENGINEERING",
    "eng_row_repair":       "REPAIR",      # row legend, sits in the group gap
    "eng_row_alloc":        "POWER",       # row legend, allocation encoders
    "eng_reactor":          "REACTOR",
    "eng_output":           "OUTPUT",
    "eng_scram":            "SCRAM",
    "eng_total":            "TOTAL POWER",
    "eng_systems":          ("WEAPONS", "ENGINES", "FTL",
                             "UTIL 1", "UTIL 2", "UTIL 3", "UTIL 4"),

    # --- 7.9 generic hardpoint -----------------------------------------
    # Soft keys are deliberately unlabelled: 7.9 has the screen render each
    # key's label beside it, LSK-style.  Fill these in only if you want
