# -*- coding: utf-8 -*-
"""
Cold Orbit - full bridge console.
FreeCAD parametric macro.  Tools > Macro > Execute.

Builds every panel from section 7 of the master plan as a separate solid,
placed in its seated-player position.

COORDINATE SYSTEM (mm), player-centric:
    X   +right / -left, 0 = player centreline
    Y   +forward, away from the player
    Z   +up from floor
Origin (0,0,0) is the floor directly below the player's eye line.

ORIENTATION, given per panel as (yaw, tilt):
    yaw   rotation about Z.  0 = facing straight back at the player.
    tilt  0 = vertical.  +ve leans the top away so the face points downward
          (overhead).  -ve lays it back so the face points upward (consoles).

NOTE: this is still mostly a LAYOUT model - most panels are floating faces,
no frame, no mounts, no joinery.  The WALLS section is a first, partial
exception, closing the gap between HOTAS, the tilt-screen, comms and the
hardpoint panels with real touching geometry, not placeholder boxing:
  - HOTAS: footprint pinned exactly between the tilt-screen's front edge
    and the main-screen/comms row, with a triangular Side (flush against
    the tilt-screen) and rectangular Back (flush against comms).
  - Propulsion/FTL: no longer flat panels facing the player - each is two
    flat triangular facets (Back/Front) meeting along a diagonal seam,
    because the four real corners they have to touch (HOTAS, the hardpoint
    panel, and comms' edge) aren't coplanar. Both facets carry real
    controls now, via TriPanel (WALLS section) - a Face authored in a
    local (u,v) grid, same as every other panel, then mapped onto the
    triangle and trimmed to it.
  - Engineering: sized to the same width as cameras, so its outer corners
    share a point with both cameras' top corners and the top hardpoint
    panels' inner-top corner. Outboard of that shared point, engineering's
    own angled face and the hardpoint panels' outward yaw diverge - filled
    solid per side (EngLeftFill/RightFill): one flat facet facing the seat,
    the bulk above and behind it, hugging the hardpoint box.
Everything else is still just floating faces; woodwork/joinery proper
comes later still.

Control legends are etched (shallow pocket) into the front face of each
panel.  All the wording lives in the LABELS dict - edit it there, nowhere
else.  Wording follows the v24 doc, section 7.
"""
import math
import os

import FreeCAD as App
import Part

# ================================================================ PARAMETERS
# >>> MEASURE AGAINST REAL PARTS BEFORE CUTTING ANYTHING <<<
PLY_T    = 5.0      # panel thickness
BOX_D    = 200.0    # enclosure depth rearward from panel front face -- MEASURE

EYE_Z    = 1150.0   # seated eye height above floor
MAIN_Y   = 750.0    # main panel plane, forward of the player
Z_SCREEN = EYE_Z - 60.0

SCREEN_W, SCREEN_H = 597.0, 336.0   # 27" visible area   -- MEASURE
TS_W, TS_H         = 340.0, 190.0   # touchscreen visible area -- MEASURE
HP_SCREEN          = 140.0          # hardpoint panel screen aperture

# Component hole diameters -- PLACEHOLDERS, verify against real parts
D_TOGGLE   = 12.0   # toggle switch bushing
D_BUTTON   = 16.0   # momentary push button
D_BTN_SM   = 14.0   # small button (hardpoint soft keys)
D_BTN_LG   = 22.0   # large / illuminated button
BTN_SQ     = 34.0   # square illuminated button (comms warn/caution + nav)
D_ESTOP    = 30.0   # emergency stop, SCRAM
D_LED      = 5.0
D_LED_SM   = 3.0
D_KNOB     = 22.0   # rotary knob shaft + bush
D_ENCODER  = 8.0    # rotary encoder shaft
D_MOUNT    = 4.5    # M4 clearance

CUT_T = PLY_T * 4.0
CUT_Z = -PLY_T

# ================================================================ COLOUR
COL_WOOD      = (0.76, 0.60, 0.42)   # pale birch ply
COL_WOOD_DARK = (0.55, 0.40, 0.25)   # darker grain, optional variation -- not
                                     # yet applied anywhere; one wood tone
                                     # across everything for this pass.

# ================================================================ COMPONENTS
# Physical facts + placeholders for the two component types Phase 1 renders.
# Square backlit button (cameras + touchscreen mode-select panels).
BTN_SQUARE_FACE   = BTN_SQ    # cap face width/height (mm) -- same part as the
                              # existing BTN_SQ panel cutout above, aliased
                              # rather than re-stated so the two can't drift
                              # apart independently.
BTN_SQUARE_CUTOUT = 23.5      # panel hole diameter (mm) for the round body
BTN_SQUARE_DEPTH  = 30.0      # body depth behind panel (mm) -- PLACEHOLDER, MEASURE
COL_BTN_BODY      = (0.2, 0.2, 0.2)
COL_BTN_BLUE      = (0.1, 0.4, 1.0)

# Guarded toggle switch "Gebildet" (every ARM position, all panels).
TOG_BODY_W    = 13.0   # body width (mm) -- PLACEHOLDER, MEASURE
TOG_BODY_D    = 19.0   # body depth front-to-back (mm) -- PLACEHOLDER, MEASURE
TOG_BODY_H    = 30.0   # body height behind panel (mm) -- PLACEHOLDER, MEASURE
TOG_CUTOUT    = D_TOGGLE   # panel hole diameter (mm) -- aliased to the
                           # existing D_TOGGLE cutout above (both 12.0mm);
                           # PLACEHOLDER, MEASURE
TOG_BAT_L     = 20.0   # bat lever length (mm) -- PLACEHOLDER, MEASURE
TOG_GUARD_H   = 50.0   # guard height above panel when open (mm) -- PLACEHOLDER, MEASURE
TOG_GUARD_W   = 20.0   # guard width (mm) -- PLACEHOLDER, MEASURE
COL_TOG_BODY  = (0.15, 0.15, 0.15)   # black
COL_TOG_BAT   = (0.75, 0.75, 0.80)   # chrome
COL_TOG_GUARD = (0.85, 0.10, 0.10)   # red

# Render components (buttons, switches) on top of the wood, or skip them for
# a faster/cleaner model. A Qt Yes/No box rather than input(): the explode
# dialog below is this macro's established interactive-prompt pattern, and
# input() has no reliable stdin inside FreeCAD's GUI console. This can't
# just reuse that same dialog instance, though - the WALLS section below
# (propulsion_ftl_walls()) needs RENDER_COMPONENTS while building the
# FTL/Propulsion TriPanels, long before the explode dialog runs - so this
# prompt has to fire here, on its own, ahead of everything downstream that
# gates on it.
try:
    from PySide2 import QtWidgets as _RcQt
except ImportError:
    from PySide import QtGui as _RcQt

_rc_app = _RcQt.QApplication.instance() or _RcQt.QApplication([])
RENDER_COMPONENTS = _RcQt.QMessageBox.question(
    None, "Cold Orbit Console", "Render components (buttons, switches)?",
    _RcQt.QMessageBox.Yes | _RcQt.QMessageBox.No,
    _RcQt.QMessageBox.No) == _RcQt.QMessageBox.Yes

# ================================================================ LETTERING
SHOW_LABELS  = True     # False = plain panels, no etching
ETCH_D       = 0.6      # etch pocket depth into the front face
TEXT_GAP     = 3.5      # clear space between a control edge and its legend
TITLE_INSET  = 6.0      # panel title, in from the panel edge

# Cap heights (mm).  Approximate - the font is scaled so capitals land here.
TEXT_H_TITLE = 7.0      # panel title
TEXT_H_HDR   = 5.0      # column / group headers
TEXT_H       = 3.6      # normal control legend
TEXT_H_TINY  = 2.4      # cycle arrows, missile-type numerals

CAP_RATIO    = 0.73     # Oswald cap height as a fraction of nominal font size
                        # (font-specific - adjust if you swap FONT_FILE and the
                        # etched capitals don't measure TEXT_H)

# Oswald - condensed, which is what keeps the longer legends inside a column.
# Leave FONT_FILE empty to auto-pick the first candidate that exists.
# Note: the variable-weight file etches at its default weight; drop a static
# Oswald-Bold.ttf in and point FONT_FILE at it if you want heavier strokes.
FONT_FILE       = ""
FONT_CANDIDATES = [
    os.path.expanduser("~/Library/Fonts/Oswald-VariableFont_wght.ttf"),
    os.path.expanduser("~/Library/Fonts/Oswald-Bold.ttf"),
    os.path.expanduser("~/Library/Fonts/Oswald-Regular.ttf"),
    "/Library/Fonts/Oswald-VariableFont_wght.ttf",
    "/usr/share/fonts/truetype/oswald/Oswald-VariableFont_wght.ttf",
    "C:/Windows/Fonts/Oswald-VariableFont_wght.ttf",
    # Last-ditch fallbacks so the macro still runs on a machine without Oswald.
    "/System/Library/Fonts/Supplemental/Arial Narrow Bold.ttf",
    "/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf",
    "C:/Windows/Fonts/arialbd.ttf",
]

