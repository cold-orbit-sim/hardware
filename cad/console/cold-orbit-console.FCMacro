    # Left-to-right order is still open in 7.3 - reorder here when it lands.
    "cameras_title":        "CAMERAS",
    "cameras_views":        ("FORWARD", "AFT", "CHASE", "DORSAL",
                             "VENTRAL", "DOCKING", "DAMAGE"),

    # --- 7.4 touchscreen mode select -----------------------------------
    # Left-to-right order also still open in 7.4.
    "ts_modes_title":       "MODE SELECT",
    "ts_modes_modes":       ("ENGINEERING", "PROPULSION", "FTL", "TURRETS",
                             "MISSILES", "COMMS", "HARDPOINTS", "MAP"),

    # --- 7.5 comms -----------------------------------------------------
    # No panel title: master warn/caution and volume are ship-wide, not
