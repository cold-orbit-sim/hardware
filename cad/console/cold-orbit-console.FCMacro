    "ftl_jump":             "JUMP",

    # --- 7.7 propulsion ------------------------------------------------
    "prop_title":           "PROPULSION",
    "prop_cutoff":          "EMERGENCY CUTOFF",
    "prop_ignition":        "IGNITION",
    "prop_arm":             "ARM",
    "prop_mix":             "PROPELLANT MIX",
    "prop_mix_lean":        "LEAN",
    "prop_mix_rich":        "RICH",
